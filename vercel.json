{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "BASE_PATH=/kariyer/ npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/kariyer",
      "destination": "/kariyer/index.html"
    },
    {
      "source": "/",
      "destination": "/kariyer/index.html"
    }
  ],
  "headers": [
    {
      "source": "/kariyer/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
